---
layout: null
---
{% assign docs = site.posts | concat: site.deeper %}
[{% for post in docs %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | jsonify }},
    "date": {{ post.date | date: '%b %-d, %Y' | jsonify }},
    "categories": {{ post.categories | join: ' ' | jsonify }},
    {% capture text %}{{ post.subtitle }} {{ post.content | strip_html }}{% endcapture %}
    "text": {{ text | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}{% endfor %}
]
